    "Tos'n DOs shows what is due now and keeps everything else one tap away.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Tos'n DOs は、いま期限が来ているものだけを見せ、それ以外はすぐ手の届くところに置いておきます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Tos'n DOs 只显示现在到期的事，其余的都在一步之内。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Tos'n DOs 只顯示現在到期的事，其餘的都在一步之內。"
          }
