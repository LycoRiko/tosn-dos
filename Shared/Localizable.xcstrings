            "state": "translated",
            "value": "残す"
          }
        }
      }
    },
    "Sharing sends the list only. Materials stay on this device.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "分享只发送清单结构，材料留在本机。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "分享只傳送清單結構，素材留在本機。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "共有されるのはリストの構成だけです。素材はこの端末に残ります。"
          }
        }
      }
    },
    "How many": {
